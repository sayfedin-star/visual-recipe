---
import { Image } from 'astro:assets';
import { urlFor } from '../lib/urlFor';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt, width, height, sizes = "100vw", class: className = "", loading = "lazy", fetchpriority } = Astro.props;

if (!src) {
  return null;
}

// Extract original image URL from Sanity
const mainUrl = urlFor(src).url();

// Default widths if width isn't provided or requires responsivenes
const widths = [150, 300, 450, 600, 750, 900, 1050, 1200];
---

<Image
  src={mainUrl}
  alt={alt}
  width={width || 800}
  height={height || 600}
  format="avif"
  widths={widths}
  sizes={sizes}
  class={className}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={fetchpriority}
/>
