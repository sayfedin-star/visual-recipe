---
interface Props {
  hubs?: Array<{ title: string; slug: string }>;
}

const { hubs = [] } = Astro.props;
---

<footer class="main-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Info Column -->
      <div class="footer-column info-column">
        <a href="/" class="footer-logo">
          <span class="logo-icon">V</span>
          <span class="logo-text">VisualRecipes</span>
        </a>
        <p class="footer-desc">
          A visual recipe discovery platform built for seamless interest-based cooking discovery. Modeled after the intuitive layouts of Pinterest.
        </p>
      </div>

      <!-- Hubs Taxonomy Column -->
      <div class="footer-column">
        <h4 class="column-title">Interest Clusters</h4>
        <ul class="column-links">
          {hubs.slice(0, 5).map((hub) => (
            <li>
              <a href={`/hub/${hub.slug}`}>{hub.title}</a>
            </li>
          ))}
          {hubs.length === 0 && (
            <>
              <li><a href="/hub/chicken-recipes">Chicken Recipes</a></li>
              <li><a href="/hub/easy-dinner">Easy Dinners</a></li>
              <li><a href="/hub/healthy-lunch">Healthy Lunches</a></li>
              <li><a href="/hub/meal-prep">Meal Prep Ideas</a></li>
              <li><a href="/hub/high-protein">High Protein Meals</a></li>
            </>
          )}
        </ul>
      </div>

      <!-- Intent Spaces Column -->
      <div class="footer-column">
        <h4 class="column-title">Intent Spaces</h4>
        <ul class="column-links">
          <li><a href="/search?q=one-pan">One-Pan Recipes</a></li>
          <li><a href="/search?q=quick">Quick & Easy</a></li>
          <li><a href="/search?q=family-friendly">Family Friendly</a></li>
          <li><a href="/search?q=make-ahead">Make Ahead Meals</a></li>
          <li><a href="/search?q=healthy">Healthy Options</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Visual Recipes. All rights reserved.</p>
      <div class="footer-meta-links">
        <a href="/sitemap.xml">Sitemap</a>
        <a href="/rss.xml">RSS Feed</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .main-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 4rem 0 2rem 0;
    color: var(--color-text);
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .logo-icon {
    background-color: var(--color-primary);
    color: #ffffff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }

  .footer-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 380px;
    line-height: 1.6;
  }

  .column-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .column-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .column-links a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .column-links a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .footer-meta-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-meta-links a:hover {
    color: var(--color-primary);
  }
</style>
