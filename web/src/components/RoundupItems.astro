---
import SanityImage from './SanityImage.astro';
import { getRecipeRating } from '../lib/sanity';

interface Props {
  items: Array<{
    recipe?: {
      _id: string;
      title: string;
      slug: string;
      mainImage: import("../lib/types").SanityImage;
      excerpt: string;
      badges?: string[];
      prepTime?: number;
      cookTime?: number;
    };
    title?: string;
    description: string;
    image?: import("../lib/types").SanityImage;
    externalUrl?: string;
    customCta?: string;
    imageDisplayMode?: 'cover' | 'contain' | 'original';
  }>;
  prioritizeFirst?: boolean;
}

const { items = [], prioritizeFirst = false } = Astro.props;


// Helper to extract dimensions from Sanity image asset ID/reference
function getSanityImageDimensions(source: import("../lib/types").SanityImage) {
  if (!source) return null;
  let ref = '';
  if (typeof source === 'string') {
    ref = source;
  } else if (source.asset && typeof source.asset._ref === 'string') {
    ref = source.asset._ref;
  } else if (source.asset && typeof source.asset._id === 'string') {
    ref = source.asset._id;
  }
  
  if (!ref) return null;
  
  const parts = ref.split('-');
  if (parts.length >= 3) {
    const dimensions = parts[2];
    const [widthStr, heightStr] = dimensions.split('x');
    const width = parseInt(widthStr, 10);
    const height = parseInt(heightStr, 10);
    if (!isNaN(width) && !isNaN(height)) {
      return { width, height, aspectRatio: width / height };
    }
  }
  return null;
}
---

<div class="roundup-list">
  {items.map((item, index) => {
    const isEven = index % 2 === 0;
    const itemTitle = item.title || item.recipe?.title || 'Untitled Recipe';
    const itemImage = item.image || item.recipe?.mainImage;
    const isExternal = !!item.externalUrl;
    const targetUrl = isExternal 
      ? item.externalUrl 
      : (item.recipe?.slug ? `/recipe/${item.recipe.slug}` : '#');
    
    // Quick metadata for internal recipe
    const badges = item.recipe?.badges || [];
    const prepTime = item.recipe?.prepTime;
    const cookTime = item.recipe?.cookTime;

    // Get rating info using shared utility
    const ratingInfo = getRecipeRating(itemTitle);

    const displayMode = item.imageDisplayMode || 'cover';
    const dimensions = getSanityImageDimensions(itemImage);

    let imageWidth = 500;
    let imageHeight = 375;
    let wrapperStyle = '';
    let finalMode = displayMode;

    if (displayMode === 'original') {
      if (dimensions) {
        imageWidth = 500;
        imageHeight = Math.round(500 / dimensions.aspectRatio);
        wrapperStyle = `aspect-ratio: ${dimensions.width} / ${dimensions.height};`;
      } else {
        finalMode = 'cover';
      }
    }

    return (
      <article class={`roundup-item ${isEven ? 'even' : 'odd'}`}>
        <!-- Item Visual Media -->
        <div class={`roundup-media-wrapper mode-${finalMode}`} style={wrapperStyle}>
          <a href={targetUrl} class="media-link" target={isExternal ? "_blank" : "_self"} rel={isExternal ? "noopener noreferrer" : ""}>
            {itemImage ? (
              <SanityImage 
                src={itemImage} 
                alt={itemTitle}
                width={imageWidth}
                height={imageHeight}
                sizes="(min-width: 1280px) 500px, (min-width: 768px) 45vw, calc(100vw - 48px)"
                class={`roundup-image display-${finalMode}`}
                loading={index === 0 && prioritizeFirst ? "eager" : "lazy"}
                fetchpriority={index === 0 && prioritizeFirst ? "high" : undefined}
              />
            ) : (
              <div class="roundup-image-placeholder">🍳 No Image Available</div>
            )}
          </a>
        </div>

        <!-- Item Content Details -->
        <div class="roundup-info-wrapper">
          <div class="roundup-header">
            <span class="item-number">{index + 1}</span>
            <h3 class="item-title">
              <a href={targetUrl} target={isExternal ? "_blank" : "_self"} rel={isExternal ? "noopener noreferrer" : ""}>
                {itemTitle}
              </a>
            </h3>
          </div>

          <!-- Internal recipe quick metadata -->
          {(prepTime || cookTime || badges.length > 0) && (
            <div class="item-meta-row">
              {prepTime !== undefined && cookTime !== undefined && (
                <span class="meta-time">
                  ⏱️ {prepTime + cookTime} mins
                </span>
              )}
              {badges.slice(0, 2).map(badge => (
                <span class="meta-badge">{badge}</span>
              ))}
            </div>
          )}

          <p class="item-description">{item.description}</p>

          <!-- Ratings Section -->
          <div class="rating-container">
            <div class="stars" role="img" aria-label={`Rating: ${ratingInfo.rating} out of 5 stars`}><span aria-hidden="true">★ ★ ★ ★ ★</span></div>
            <div class="rating-text">{ratingInfo.votes} REVIEWS / {ratingInfo.rating} AVERAGE</div>
          </div>

          <!-- Action Button -->
          <a 
            href={targetUrl} 
            class="cta-button"
            target={isExternal ? "_blank" : "_self"}
            rel={isExternal ? "noopener noreferrer" : ""}
          >
            {item.customCta || 'MAKE THIS RECIPE'}
          </a>
        </div>
      </article>
    );
  })}
</div>

<style>
  .roundup-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin: 3rem 0;
  }

  .roundup-item {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    content-visibility: auto;
    contain-intrinsic-size: auto 970px;
  }

  .roundup-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 768px) {
    .roundup-item {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
      border: none;
      box-shadow: none;
      background: transparent;
      border-radius: 0;
      overflow: visible;
      contain-intrinsic-size: auto 400px;
    }

    .roundup-item:hover {
      transform: none;
      box-shadow: none;
    }

    .roundup-item.odd {
      flex-direction: row-reverse;
    }
  }

  /* Media Section */
  .roundup-media-wrapper {
    position: relative;
    flex: 1;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .roundup-media-wrapper.mode-original {
    aspect-ratio: auto;
  }

  .media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .roundup-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .roundup-image.display-contain {
    object-fit: contain;
  }

  .roundup-image.display-original {
    object-fit: cover;
  }

  .roundup-item:hover .roundup-image.display-cover,
  .roundup-item:hover .roundup-image.display-original {
    transform: scale(1.05);
  }

  .roundup-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }


  /* Info Section */
  .roundup-info-wrapper {
    flex: 1.1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .roundup-info-wrapper {
      padding: 0;
    }
  }

  .roundup-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .item-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: #eab308; /* Yellow/Gold */
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    flex-shrink: 0;
    line-height: 1;
    margin-top: 0.1rem;
  }

  .item-title {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.25;
    margin-top: 0.25rem;
  }

  .item-title a:hover {
    color: var(--color-primary);
  }

  /* Internal Recipe Metadata */
  .item-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .meta-time {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-surface);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .meta-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .item-description {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Ratings Section */
  .rating-container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.5rem 0;
  }

  .stars {
    color: #f59e0b; /* Amber/gold */
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }

  .rating-text {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  /* Buttons styling */
  .cta-button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    padding: 0.8rem 1.75rem;
    border-radius: 4px;
    background-color: #6c3057; /* Plum/Burgundy matching mockup */
    color: #ffffff;
    border: none;
    text-transform: uppercase;
    transition: background-color 0.2s, transform 0.2s;
    margin-top: 0.5rem;
    cursor: pointer;
  }

  .cta-button:hover {
    background-color: #552544;
    transform: translateY(-2px);
  }

  .cta-button:active {
    transform: translateY(0);
  }
</style>
