---
import { urlFor } from '../lib/urlFor';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt, width = 800, height = 600, sizes = "(min-width: 1200px) 1200px, 100vw", class: className = "", loading = "lazy", fetchpriority } = Astro.props;

if (!src) {
  return null;
}

const IMAGE_QUALITY = 65;

// Differentiate between LCP hero and non-critical images for widths
const isHero = fetchpriority === 'high';
const widths = isHero ? [360, 540, 720, 900] : [200, 400, 600];

// Generate srcset using Sanity CDN transforms (no Sharp/build-time processing needed)
const srcset = widths
  .map(w => `${urlFor(src).width(w).auto('format').quality(IMAGE_QUALITY).url()} ${w}w`)
  .join(', ');

const defaultSrc = urlFor(src).width(width).auto('format').quality(IMAGE_QUALITY).url();
---

<img
  src={defaultSrc}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
