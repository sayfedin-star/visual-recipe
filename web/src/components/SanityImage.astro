---
import { Image } from 'astro:assets';
import { urlFor } from '../lib/urlFor';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt, width, height, sizes = "(min-width: 1200px) 1200px, 100vw", class: className = "", loading = "lazy", fetchpriority } = Astro.props;

if (!src) {
  return null;
}

// Extract original image URL from Sanity
const mainUrl = urlFor(src).url();

// Differentiate between LCP hero and non-critical images for widths
const isHero = fetchpriority === 'high';
const widths = isHero ? [360, 540, 720, 900] : [200, 400, 600];
---

<Image
  src={mainUrl}
  alt={alt}
  width={width || 800}
  height={height || 600}
  format="avif"
  widths={widths}
  sizes={sizes}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  quality={65}
/>
