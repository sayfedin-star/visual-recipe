---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';
const isExplore = pathname.startsWith('/search');
const isSaved = pathname.startsWith('/saved');
---

<header class="main-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="logo-area" aria-label="Visual Recipes Home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="logo-icon" aria-hidden="true" width="32" height="32" fill="currentColor"><path d="M16 2L2 30h28L16 2zm0 6l9.5 19h-19L16 8z"/></svg>
      <span class="logo-text">VisualRecipes</span>
    </a>

    <!-- Mobile Search Trigger -->
    <a href="/search" class="search-mobile-trigger" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
      </svg>
    </a>

    <!-- Search Box -->
    <form action="/search" method="GET" class="search-form">
      <div class="search-input-wrapper">
        <span class="search-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
          </svg>
        </span>
        <input 
          type="search" 
          name="q" 
          placeholder="Search recipes, ingredients, intent tags..." 
          class="search-input"
          aria-label="Search recipes"
          required
        />
      </div>
    </form>

    <!-- Navigation -->
    <nav class="nav-links">
      <a href="/" class={`nav-link ${isHome ? 'active' : ''}`}>Home</a>
      <a href="/search" class={`nav-link ${isExplore ? 'active' : ''}`}>Explore</a>
      <a href="/saved" class={`nav-link ${isSaved ? 'active' : ''}`}>Saved</a>
    </nav>
  </div>
</header>

<style>
  .main-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .header-container {
      padding: 0 1.5rem;
      justify-content: flex-start;
      gap: 1.5rem;
    }
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-primary);
  }

  .logo-icon {
    background-color: var(--color-primary);
    color: #ffffff;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .logo-text {
    display: none;
  }

  @media (min-width: 1024px) {
    .logo-text {
      display: inline;
    }
  }

  /* Mobile Search Trigger */
  .search-mobile-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #efefef;
    color: #111111;
    transition: background-color 0.2s, transform 0.1s;
  }

  .search-mobile-trigger:hover {
    background-color: #e2e2e2;
  }

  .search-mobile-trigger:active {
    transform: scale(0.95);
  }

  @media (min-width: 768px) {
    .search-mobile-trigger {
      display: none;
    }
  }

  /* Search box (Desktop only) */
  .search-form {
    display: none;
    flex-grow: 1;
  }

  @media (min-width: 768px) {
    .search-form {
      display: block;
    }
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--color-text-muted);
  }

  .search-input {
    width: 100%;
    background-color: #f1f1f1;
    border: none;
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.65rem 1rem 0.65rem 2.5rem;
    border-radius: var(--radius-lg);
    outline: none;
    color: var(--color-text);
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .search-input:hover {
    background-color: var(--color-border);
  }

  .search-input:focus {
    background-color: #ffffff;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.1);
  }

  /* Nav menu */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 640px) {
    .nav-links {
      gap: 0.75rem;
    }
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 700;
    color: #5f5f5f;
    padding: 0.5rem 0.75rem;
    border-radius: 9999px;
    transition: background-color 0.2s, color 0.2s;
  }

  .nav-link:hover {
    background-color: #f0f0f0;
    color: #111111;
  }

  .nav-link.active {
    color: #111111;
    background-color: transparent;
  }
</style>
