---
interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: Record<string, any>;
}

const { title, description = "Discover delicious recipes styled visually to inspire your cooking.", image, schema } = Astro.props;

// Domain-aware canonical URL using Astro.site as the single source of truth
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const shareImage = image || new URL('/favicon.svg', Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Headers -->
    <title>{title} | Visual Recipes</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={shareImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap">
    </noscript>

    <!-- Schema.org Integration -->
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
    <!-- Custom Head Slot -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- LocalStorage Save Recipes Synchronization Script -->
    <script>
      let savedList: string[] = [];
      try { savedList = JSON.parse(localStorage.getItem('saved-recipes') || '[]'); } catch {}
      document.querySelectorAll('[data-recipe-id]').forEach((card) => {
        const recipeId = card.getAttribute('data-recipe-id');
        if (recipeId && savedList.includes(recipeId)) {
          const saveBtn = card.querySelector('[data-save-btn]');
          if (saveBtn) {
            saveBtn.classList.add('saved');
          }
        }
      });

      // Event delegation for save buttons
      document.addEventListener('click', (e) => {
        const saveBtn = (e.target as HTMLElement).closest('[data-save-btn]');
        if (saveBtn) {
          e.preventDefault();
          e.stopPropagation();

          const card = saveBtn.closest('[data-recipe-id]');
          const recipeId = card ? card.getAttribute('data-recipe-id') : null;

          if (recipeId) {
            let saved: string[] = [];
            try { saved = JSON.parse(localStorage.getItem('saved-recipes') || '[]'); } catch {}
            saveBtn.classList.toggle('saved');
            const isSaved = saveBtn.classList.contains('saved');

            if (isSaved) {
              if (!saved.includes(recipeId)) {
                saved.push(recipeId);
              }
            } else {
              saved = saved.filter((id: string) => id !== recipeId);
            }
            try { localStorage.setItem('saved-recipes', JSON.stringify(saved)); } catch {}
            
            // Trigger a custom event to notify other components (like Saved board page)
            document.dispatchEvent(new CustomEvent('saved-recipes-changed', { detail: { recipeId, isSaved } }));
          }
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-heading: 'Outfit', 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;

    /* Pinterest-style Color Palette */
    --color-primary: #e60023; /* Pinterest Red */
    --color-primary-hover: #ad0018;
    --color-bg: #ffffff;
    --color-surface: #f5f5f5;
    --color-text: #111111;
    --color-text-muted: #5f5f5f;
    --color-border: #e2e8f0;
    
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);

    --radius-sm: 8px;
    --radius-md: 16px;
    --radius-lg: 32px;
  }

  /* Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  /* Smooth scroll support */
  html {
    scroll-behavior: smooth;
  }

  /* Premium details */
  ::selection {
    background-color: var(--color-primary);
    color: white;
  }

  /* --- Global Recipe Card Styles --- */
  .recipe-card {
    display: block;
    width: 100%;
    margin-bottom: 0.75rem;
    break-inside: avoid; /* Prevents card split in CSS columns masonry */
    -webkit-column-break-inside: avoid; /* Safari/Chrome fallback */
    page-break-inside: avoid; /* Firefox fallback */
    background: var(--color-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (min-width: 640px) {
    .recipe-card {
      margin-bottom: 1.5rem;
    }
  }

  .recipe-card:hover {
    transform: translateY(-4px);
  }

  .image-container {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .image-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .recipe-card:hover .card-img {
    transform: scale(1.04);
  }

  /* Hover Overlay Pinterest Style */
  .hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 10;
  }

  .recipe-card:hover .hover-overlay {
    opacity: 1;
  }

  .view-btn {
    background-color: #ffffff;
    color: #111111;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .view-btn:hover {
    transform: scale(1.05);
    background-color: #f5f5f5;
  }

  .save-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: rgba(255, 255, 255, 0.9);
    color: #5f5f5f;
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, transform 0.2s;
  }

  .save-btn:hover {
    transform: scale(1.1);
    background-color: #ffffff;
  }

  /* Saved state */
  .save-btn.saved {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  /* Floating tags */
  .category-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(4px);
    color: #111111;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    z-index: 10;
    transition: background-color 0.2s, color 0.2s;
  }

  .category-badge:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .roundup-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(230, 0, 35, 0.95);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    z-index: 10;
    letter-spacing: 0.05em;
  }

  /* Details Area */
  .card-details {
    padding: 0.75rem 0.25rem;
  }

  .title-link {
    display: block;
    margin-bottom: 0.25rem;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--color-text);
    /* Multi-line truncation */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title:hover {
    color: var(--color-primary);
  }

  .card-excerpt {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .badge {
    font-size: 0.7rem;
    font-weight: 500;
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  /* Aspect Ratio Helpers */
  .aspect-\[4\/3\] {
    aspect-ratio: 4 / 3;
  }
  .aspect-\[2\/3\] {
    aspect-ratio: 2 / 3;
  }
  .aspect-\[1\/2\] {
    aspect-ratio: 1 / 2;
  }

  /* Icon Utility Classes */
  .w-5 {
    width: 1.25rem !important;
  }
  .h-5 {
    height: 1.25rem !important;
  }
  .w-4 {
    width: 1rem !important;
  }
  .h-4 {
    height: 1rem !important;
  }
  .w-3\.5 {
    width: 0.875rem !important;
  }
  .h-3\.5 {
    height: 0.875rem !important;
  }
</style>
