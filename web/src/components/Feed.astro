---
import type { Recipe, SanityImage } from '../lib/types';
import Card from './Card.astro';

interface Props {
  recipes: Array<{
    _id: string;
    title: string;
    slug: string;
    excerpt: string;
    mainImage: SanityImage;
    cardAspectRatio?: 'standard' | 'tall' | 'super-tall';
    badges?: string[];
    intentTags?: string[];
    season?: string;
    parentCluster?: { title: string; slug: string };
  }>;
  initialCount?: number;
  prioritizeFirst?: boolean;
}

const { recipes = [], initialCount = 12, prioritizeFirst = true } = Astro.props;
---

<div class="feed-container">
  {recipes.length === 0 ? (
    <div class="empty-feed">
      <p>No recipes found matching these filters.</p>
    </div>
  ) : (
    <>
      <div class="masonry-grid" id="recipes-feed">
        {recipes.slice(0, initialCount).map((recipe, index) => (
          <div 
            class="masonry-item"
            data-feed-item
            data-intent={recipe.intentTags?.join(' ')}
            data-season={recipe.season}
            data-cluster={recipe.parentCluster?.slug}
            data-badges={recipe.badges?.join(' ')}
          >
            <Card 
              recipe={recipe} 
              loading={index === 0 && prioritizeFirst ? 'eager' : 'lazy'} 
              fetchpriority={index === 0 && prioritizeFirst ? 'high' : undefined}
            />
          </div>
        ))}
      </div>

      {recipes.length > initialCount && (
        <div class="feed-actions" id="load-more-container">
          <div id="feed-sentinel" class="feed-sentinel" aria-hidden="true"></div>
          <button id="load-more-btn" class="load-more-button" type="button">
            Discover More Recipes
          </button>
          <p id="feed-status" class="sr-only" aria-live="polite"></p>
        </div>
      )}
    </>
  )}
</div>

<script>

  const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
  const loadMoreContainer = document.getElementById('load-more-container');
  const feed = document.getElementById('recipes-feed');
  const sentinel = document.getElementById('feed-sentinel');
  const status = document.getElementById('feed-status');

  if (loadMoreBtn && feed) {
    let recipesCache: import("../lib/types").Recipe[] | null = null;
    let remainingRecipes: import("../lib/types").Recipe[] = [];
    let isLoaded = false;
    let loadingPromise: Promise<void> | null = null;
    let isAppending = false;
    const step = 8;
    let currentIndex = 0;

    // Prevent XSS from CMS-injected content in innerHTML
    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    const aspectMap: Record<string, string> = {
      standard: 'aspect-[4/3]',
      tall: 'aspect-[2/3]',
      'super-tall': 'aspect-[1/2]',
    };

    function buildCardHTML(r: import("../lib/types").Recipe): string {
      const aspect = aspectMap[r.cardAspectRatio || "tall"] || 'aspect-[2/3]';
      const aspectWidth = 400;
      const aspectHeight = r.cardAspectRatio === 'standard' ? 300 : r.cardAspectRatio === 'super-tall' ? 800 : 600;
      const imgSrc = r.imageUrl || '/favicon.svg';
      let imgSrcSet = '';
      if (r.imageUrl && r.imageUrl.includes('cdn.sanity.io')) {
        const urlWithoutParams = r.imageUrl.split('?')[0];
        imgSrcSet = `${urlWithoutParams}?w=200&q=65&auto=format 200w, ${urlWithoutParams}?w=400&q=65&auto=format 400w, ${urlWithoutParams}?w=600&q=65&auto=format 600w`;
      }
      const sizes = "(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 50vw";
      const clusterBadge = r.parentCluster
        ? `<a href="/hub/${escapeHtml(r.parentClusterSlug || "")}" class="category-badge">${escapeHtml(r.parentCluster.title)}</a>`
        : '';
      const roundupBadge = r.publicationType === 'roundup'
        ? `<span class="roundup-badge">Round-Up</span>`
        : '';
      const badgesHTML = (r.badges || []).slice(0, 2)
        .map((b: string) => `<span class="badge">${escapeHtml(b)}</span>`)
        .join('');

      return `
        <article class="recipe-card" data-recipe-id="${escapeHtml(r.id || "")}">
          <div class="image-container ${aspect}">
            <a href="/recipe/${escapeHtml(r.slug)}" class="image-link"
               aria-label="View recipe instructions for ${escapeHtml(r.title)}">
              <img src="${escapeHtml(imgSrc)}" srcset="${escapeHtml(imgSrcSet)}" sizes="${sizes}" alt="${escapeHtml(r.title)}" width="${aspectWidth}" height="${aspectHeight}"
                   style="aspect-ratio:${aspectWidth}/${aspectHeight};width:100%;height:auto"
                   loading="lazy" decoding="async" class="card-img" />
              <div class="hover-overlay">
                <span class="view-btn">View Recipe</span>
              </div>
            </a>
            <button type="button" class="save-btn" data-save-btn aria-label="Save Recipe">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
              </svg>
            </button>
            ${clusterBadge}${roundupBadge}
          </div>
          <div class="card-details">
            <a href="/recipe/${escapeHtml(r.slug)}" class="title-link">
              <h3 class="card-title">${escapeHtml(r.title)}</h3>
            </a>
            <p class="card-excerpt">${escapeHtml(r.excerpt || '')}</p>
            ${badgesHTML ? `<div class="card-badges">${badgesHTML}</div>` : ''}
          </div>
        </article>`;
    }

    function finishFeed() {
      if (observer) observer.disconnect();
      if (loadMoreContainer) loadMoreContainer.style.display = 'none';
      if (status) status.textContent = 'All recipes loaded.';
    }

    function ensureLoaded(): Promise<void> {
      if (isLoaded) return Promise.resolve();
      if (loadingPromise) return loadingPromise;

      loadingPromise = (async () => {
        loadMoreBtn!.textContent = 'Loading...';
        loadMoreBtn!.disabled = true;
        if (status) status.textContent = 'Loading more recipes.';

        try {
          if (recipesCache === null) {
            const res = await fetch('/recipes-index.json');
            if (!res.ok) {
              throw new Error(`Recipe index request failed: ${res.status}`);
            }
            recipesCache = await res.json();
            if (!Array.isArray(recipesCache)) throw new Error('Invalid recipes index');
          }

          const renderedIds = new Set(
            Array.from(feed!.querySelectorAll('[data-recipe-id]'))
              .map((el) => el.getAttribute('data-recipe-id'))
          );

          const pathParts = window.location.pathname.split('/');
          const hubIndex = pathParts.indexOf('hub');
          let filterClusterSlug: string | null = null;
          if (hubIndex !== -1 && pathParts[hubIndex + 1]) {
            filterClusterSlug = pathParts[hubIndex + 1];
          }

          remainingRecipes = (recipesCache || []).filter((r: import("../lib/types").Recipe) => {
            if (renderedIds.has(r.id || '')) return false;
            if (filterClusterSlug && r.parentClusterSlug !== filterClusterSlug) return false;
            return true;
          });

          isLoaded = true;

          if (remainingRecipes.length === 0) {
            finishFeed();
            return;
          }

          loadMoreBtn!.textContent = 'Discover More Recipes';
        } catch (err) {
          console.error('Failed to load remaining recipes:', err);
          loadMoreBtn!.textContent = 'Failed to load. Click to retry';
          loadMoreBtn!.style.display = '';
          if (status) {
            status.textContent = 'Failed to load more recipes. Use Discover More Recipes to retry.';
          }
        } finally {
          loadingPromise = null;
          loadMoreBtn!.disabled = false;
        }
      })();

      return loadingPromise;
    }

    function appendBatch(): boolean {
      if (isAppending) return false;

      if (currentIndex >= remainingRecipes.length) {
        finishFeed();
        return false;
      }

      const batch = remainingRecipes.slice(currentIndex, currentIndex + step);

      // Reserve the index BEFORE requestAnimationFrame so another observer
      // callback cannot schedule the identical records.
      currentIndex += batch.length;
      isAppending = true;

      let savedList: string[] = [];
      try {
        savedList = JSON.parse(localStorage.getItem('saved-recipes') || '[]');
      } catch {}

      const doAppend = () => {
        try {
          batch.forEach(r => {
            const wrapper = document.createElement('div');
            wrapper.className = 'masonry-item';
            wrapper.setAttribute('data-feed-item', '');
            wrapper.innerHTML = buildCardHTML(r);

            // Sync saved state on newly generated card
            if (savedList.includes(r.id || '')) {
              const saveBtn = wrapper.querySelector('[data-save-btn]');
              if (saveBtn) {
                saveBtn.classList.add('saved');
              }
            }

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduceMotion) {
              wrapper.animate(
                [{ opacity: 0, transform: 'translateY(15px)' }, { opacity: 1, transform: 'translateY(0)' }],
                { duration: 350, easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)', fill: 'forwards' }
              );
            }
            feed!.appendChild(wrapper);
          });

          if (currentIndex >= remainingRecipes.length) {
            finishFeed();
          }
        } finally {
          isAppending = false;
        }
      };

      if (batch.length > 4 && 'requestAnimationFrame' in window) {
        requestAnimationFrame(doAppend);
      } else {
        doAppend();
      }

      return true;
    }

    async function loadNextBatch() {
      await ensureLoaded();
      if (isLoaded) {
        const appended = appendBatch();
        if (appended && observer && loadMoreBtn && loadMoreBtn.style.display !== 'none') {
           loadMoreBtn.style.display = 'none'; // hide button visually when IO is active and successful
        }
      }
    }

    let observer: IntersectionObserver | null = null;
    if ('IntersectionObserver' in window && sentinel) {
      observer = new IntersectionObserver(
        async (entries) => {
          if (!entries[0]?.isIntersecting) return;
          loadNextBatch();
        },
        { root: null, rootMargin: '400px 0px', threshold: 0 }
      );
      observer.observe(sentinel);
    }

    loadMoreBtn.addEventListener('click', () => {
      loadNextBatch();
    });
  }

</script>

<style>
  .feed-container {
    width: 100%;
    margin-top: 1.5rem;
  }

  .empty-feed {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  /* CSS Columns Masonry Engine */
  .masonry-grid {
    column-count: 2;
    column-gap: 0.75rem;
    width: 100%;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    display: block;
  }

  /* Hidden item styling */
  .hidden-item {
    display: none !important;
  }

  /* Responsive column mappings */
  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
      column-gap: 1.25rem;
    }
    .masonry-item {
      margin-bottom: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 3;
    }
    @supports (grid-template-rows: masonry) {
      .masonry-grid {
        display: grid;
        column-count: auto;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-rows: masonry;
        gap: 1.25rem;
      }
      .masonry-item { margin-bottom: 0; }
    }
  }

  @media (min-width: 1280px) {
    .masonry-grid {
      column-count: 4;
    }
    @supports (grid-template-rows: masonry) {
      .masonry-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  }

  /* Load More Action Button styling */
  .feed-actions {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    margin-bottom: 4rem;
  }

  .load-more-button {
    background-color: #111111;
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.9rem 2.2rem;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .load-more-button:hover {
    background-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .load-more-button:active {
    transform: translateY(0);
  }
</style>
