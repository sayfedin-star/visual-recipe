---
import { getImageSrcSet } from '../lib/urlFor';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const { src, alt, width, height, sizes = "100vw", class: className = "", loading = "lazy" } = Astro.props;

if (!src) {
  return null;
}

const { src: mainUrl, srcset } = getImageSrcSet(src, width, height);
---

<img
  src={mainUrl}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
