---
import { urlFor } from '../lib/urlFor';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const { src, alt, width, height, sizes = "100vw", class: className = "", loading = "lazy" } = Astro.props;

if (!src) {
  return null;
}

// Generate the optimized URLs using Sanity image pipeline
let imageUrl = urlFor(src).format('avif').quality(80);

if (width) {
  imageUrl = imageUrl.width(width);
}
if (height) {
  imageUrl = imageUrl.height(height);
}

const mainUrl = imageUrl.url().replace('https://cdn.sanity.io/images/', '/images/');

// Generate responsive srcsets for better performance
const widths = [150, 300, 450, 600, 750, 900, 1050, 1200];
const srcset = widths
  .map((w) => {
    let urlBuilder = urlFor(src).format('avif').quality(80).width(w);
    if (height && width) {
      // Keep aspect ratio
      const calculatedHeight = Math.round((w / width) * height);
      urlBuilder = urlBuilder.height(calculatedHeight);
    }
    const url = urlBuilder.url().replace('https://cdn.sanity.io/images/', '/images/');
    return `${url} ${w}w`;
  })
  .join(', ');
---

<img
  src={mainUrl}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
