---
import type { SanityImage } from '../lib/types';
import { urlFor } from '../lib/urlFor';

interface Props {
  src: SanityImage;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  widths?: number[];
}

const { src, alt, width, height, sizes = "(min-width: 1200px) 1200px, 100vw", class: className = "", loading = "lazy", fetchpriority, widths: customWidths, decoding = "async" } = Astro.props;

if (!src) {
  return null;
}

const IMAGE_QUALITY = 65;

// Differentiate between LCP hero and non-critical images for widths
const isHero = fetchpriority === 'high';
const widths = customWidths || (isHero ? [360, 540, 750, 900] : [200, 400, 600]);

// Determine display width & height dynamically to avoid oversized fallback src
const displayWidth = width || (isHero ? 800 : 400);
const displayHeight = height || (isHero ? 600 : 300);

// Calculate aspect ratio if both props are present to enable CDN-side cropping
const aspect = (width && height) ? width / height : null;

// Generate srcset using Sanity CDN transforms (no Sharp/build-time processing needed)
const srcset = widths
  .map(w => {
    let imgBuilder = urlFor(src).width(w);
    if (aspect) {
      imgBuilder = imgBuilder.height(Math.round(w / aspect)).fit('crop');
    }
    return `${imgBuilder.auto('format').quality(IMAGE_QUALITY).url()} ${w}w`;
  })
  .join(', ');

let defaultBuilder = urlFor(src).width(displayWidth);
if (width && height) {
  defaultBuilder = defaultBuilder.height(displayHeight).fit('crop');
}
const defaultSrc = defaultBuilder.auto('format').quality(IMAGE_QUALITY).url();
---

<img
  src={defaultSrc}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={displayWidth}
  height={displayHeight}
  class={className}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
/>
