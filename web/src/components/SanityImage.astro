---
import { urlFor } from '../lib/urlFor';

interface Props {
  src: any;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  widths?: number[];
}

const { src, alt, width, height, sizes = "(min-width: 1200px) 1200px, 100vw", class: className = "", loading = "lazy", fetchpriority, widths: customWidths } = Astro.props;

if (!src) {
  return null;
}

const IMAGE_QUALITY = 65;

// Differentiate between LCP hero and non-critical images for widths
const isHero = fetchpriority === 'high';
const widths = customWidths || (isHero ? [360, 540, 720, 750, 900, 1080] : [200, 400, 600]);

// Determine display width & height dynamically to avoid oversized fallback src
const displayWidth = width || (isHero ? 800 : 400);
const displayHeight = height || (isHero ? 600 : 300);

// Generate srcset using Sanity CDN transforms (no Sharp/build-time processing needed)
const srcset = widths
  .map(w => `${urlFor(src).width(w).auto('format').quality(IMAGE_QUALITY).url()} ${w}w`)
  .join(', ');

const defaultSrc = urlFor(src).width(displayWidth).auto('format').quality(IMAGE_QUALITY).url();
---

<img
  src={defaultSrc}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={displayWidth}
  height={displayHeight}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
