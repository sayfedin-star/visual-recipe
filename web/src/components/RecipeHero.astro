---
import type { SanityImage as SanityImageType } from '../lib/types';
import SanityImage from './SanityImage.astro';
import { getRecipeRating } from '../lib/sanity';
import { urlFor } from '../lib/urlFor';

interface Props {
  title: string;
  excerpt: string;
  mainImage: SanityImageType;
  hideMainImage?: boolean;
  customCtaUrl?: string;
  prepTime?: number;
  cookTime?: number;
  servings?: number;
  badges?: string[];
  jumpToRecipeAnchor?: string;
  recipeId: string;
  isRoundup?: boolean;
  parentCluster?: { title: string; slug: string };
}

const { 
  title, 
  excerpt, 
  mainImage, 
  hideMainImage = false,
  customCtaUrl,
  prepTime, 
  cookTime, 
  servings, 
  badges = [], 
  jumpToRecipeAnchor = 'recipe-card',
  recipeId,
  isRoundup = false,
  parentCluster
} = Astro.props;

const totalTime = (prepTime || 0) + (cookTime || 0);
const finalBadges = badges || [];
const ratingInfo = getRecipeRating(recipeId);

// Determine if link is external to configure target/rel properties
const isExternal = (url: string) => {
  try {
    const urlObj = new URL(url);
    return urlObj.hostname !== 'nremi.com' && urlObj.hostname !== 'www.nremi.com' && !urlObj.hostname.includes('localhost');
  } catch (e) {
    return false;
  }
};

const ctaHref = customCtaUrl || `#${jumpToRecipeAnchor}`;
const isCtaExternal = customCtaUrl ? isExternal(customCtaUrl) : false;

const lcpSizes = "(min-width: 1280px) 500px, (min-width: 768px) 45vw, (min-width: 480px) 360px, calc(100vw - 48px)";

let lcpPreloadUrl = null;
let lcpSrcSet = null;

if (!hideMainImage && mainImage && typeof mainImage === 'object' && mainImage.asset) {
  // Using the exact logic from SanityImage.astro to match src and srcset
  const aspect = 600 / 900;
  const IMAGE_QUALITY = 65;
  const imgWidth = 750;

  lcpPreloadUrl = urlFor(mainImage).width(imgWidth).height(Math.round(imgWidth / aspect)).fit('crop').auto('format').quality(IMAGE_QUALITY).url();

  const lcpWidths = [360, 750, 900];
  lcpSrcSet = lcpWidths
    .map(w => {
      let imgBuilder = urlFor(mainImage).width(w).height(Math.round(w / aspect)).fit('crop');
      return `${imgBuilder.auto('format').quality(IMAGE_QUALITY).url()} ${w}w`;
    })
    .join(', ');
}
---

<Fragment slot="head">
  {lcpPreloadUrl && (
    <link rel="preload" as="image" href={lcpPreloadUrl} imagesrcset={lcpSrcSet} imagesizes={lcpSizes} fetchpriority="high" />
  )}
</Fragment>

<section class="recipe-hero-section" data-recipe-id={recipeId}>
  <div class={`hero-grid ${hideMainImage ? 'no-image' : ''}`}>
    <!-- Metadata Panel -->
    <div class="hero-meta-container">
      <div class="meta-content">
        <!-- Breadcrumbs & Rating Header (Pinterest style) -->
        <div class="recipe-header-meta">
          <div class="breadcrumbs">
            <a href="/" class="breadcrumb-link">HOME</a>
            {parentCluster && (
              <span class="breadcrumb-separator">/</span>
              <a href={`/hub/${parentCluster.slug}`} class="breadcrumb-link">{parentCluster.title.toUpperCase()}</a>
            )}
          </div>
          
          <div class="rating-block">
            <div class="stars" role="img" aria-label={`Rating: ${ratingInfo.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => {
                const filled = i < Math.floor(ratingInfo.rating);
                return (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill={filled ? "#f39c12" : "none"} stroke="#f39c12" stroke-width="1.5" class="star-icon" aria-hidden="true">
                    <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.6 3.1-.114 4.707c-.02.836.88 1.48 1.579 1.025L10 15.547l4.088 2.602c.699.455 1.599-.189 1.579-1.025l-.114-4.707 3.6-3.1c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" />
                  </svg>
                );
              })}
            </div>
            <span class="rating-text">
              <strong>{ratingInfo.rating}</strong> from {ratingInfo.votes} votes
            </span>
          </div>
        </div>

        <h1 class="recipe-title">{title}</h1>
        <p class="recipe-excerpt">{excerpt}</p>

        <!-- Sticky Jump to Recipe Button -->
        <div class="cta-actions">
          <a 
            href={ctaHref} 
            class="jump-cta-btn"
            target={isCtaExternal ? "_blank" : undefined}
            rel={isCtaExternal ? "noopener noreferrer" : undefined}
          >
            <span>{isRoundup ? 'View Round-Up' : 'Jump to Recipe'}</span>
            {customCtaUrl ? (
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="cta-arrow">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="cta-arrow">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
              </svg>
            )}
          </a>
          <!-- Pinterest Save button next to CTA -->
          <button type="button" class="save-cta-btn" data-save-btn>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 save-icon">
              <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
            </svg>
            <span class="save-label">{isRoundup ? 'Save Round-Up' : 'Save Recipe'}</span>
          </button>
        </div>

        <!-- Badges list -->
        {finalBadges.length > 0 && (
          <div class="recipe-badges-list">
            {finalBadges.map((badge) => (
              <span class="badge-tag">{badge}</span>
            ))}
          </div>
        )}

        <!-- Time and Servings grids -->
        {(prepTime || cookTime || servings) && (
          <div class="specs-grid">
            {prepTime && (
              <div class="spec-item">
                <span class="spec-label">Prep Time</span>
                <span class="spec-value">{prepTime} mins</span>
              </div>
            )}
            {cookTime && (
              <div class="spec-item">
                <span class="spec-label">Cook Time</span>
                <span class="spec-value">{cookTime} mins</span>
              </div>
            )}
            {totalTime > 0 && (
              <div class="spec-item highlight">
                <span class="spec-label">Total Time</span>
                <span class="spec-value">{totalTime} mins</span>
              </div>
            )}
            {servings && (
              <div class="spec-item">
                <span class="spec-label">Servings</span>
                <span class="spec-value">{servings} servings</span>
              </div>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- Clickable Large Portrait Hero Image -->
    {!hideMainImage && (
      <div class="hero-image-container">
        <a 
          href={ctaHref} 
          class="hero-image-link" 
          target={isCtaExternal ? "_blank" : undefined}
          rel={isCtaExternal ? "noopener noreferrer" : undefined}
          aria-label={customCtaUrl ? `Open link: ${title}` : (isRoundup ? "Jump directly to the round-up items" : "Jump directly to recipe card instructions")}
        >
          <div class="image-wrapper">
            <SanityImage
              src={mainImage}
              alt={mainImage?.alt || title}
              width={600}
              height={900}
              sizes={lcpSizes}
              class="hero-img"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              widths={[360, 750, 900]}
            />
            <div class="image-overlay">
              <span class="jump-label">
                {customCtaUrl ? 'Click to View Link' : (isRoundup ? 'Click to View Round-Up' : 'Click to Jump to Recipe')}
              </span>
            </div>
          </div>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .recipe-hero-section {
    margin-bottom: 3rem;
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-image-container {
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-grid:not(.no-image) {
      display: grid;
      grid-template-columns: 1.2fr 1.5fr;
      gap: 3rem;
      align-items: start;
    }
    .hero-grid:not(.no-image) .hero-image-container {
      grid-column: 1;
      grid-row: 1;
    }
    .hero-grid:not(.no-image) .hero-meta-container {
      grid-column: 2;
      grid-row: 1;
    }
    .hero-grid.no-image {
      max-width: 800px;
      margin: 0 auto;
    }
  }

  .hero-image-link {
    display: block;
    cursor: pointer;
  }

  .image-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 2/3;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .image-wrapper:hover .hero-img {
    transform: scale(1.03);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .image-wrapper:hover .image-overlay {
    opacity: 1;
  }

  .jump-label {
    background-color: #ffffff;
    color: #111111;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* Metadata Panel */
  .hero-meta-container {
    padding: 1rem 0;
  }

  .recipe-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 1024px) {
    .recipe-title {
      font-size: 3rem;
    }
  }

  .recipe-excerpt {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* CTA actions - Pinterest style side-by-side pill buttons */
  .cta-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .save-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: #efefef;
    color: #111111;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
  }

  .save-cta-btn:hover {
    background-color: #e2e2e2;
  }

  .save-cta-btn:active {
    transform: scale(0.98);
  }

  .save-cta-btn.saved {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .save-icon {
    width: 18px;
    height: 18px;
  }

  .jump-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: #e60023; /* Pinterest Red */
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    border: none;
    transition: background-color 0.2s, transform 0.1s;
  }

  .jump-cta-btn:hover {
    background-color: #ad001a;
  }

  .jump-cta-btn:active {
    transform: scale(0.98);
  }

  .cta-arrow {
    width: 1.1rem;
    height: 1.1rem;
    display: inline-block;
    vertical-align: middle;
  }

  /* Badges */
  .recipe-badges-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .badge-tag {
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  /* Specs Grid */
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .specs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .spec-item {
    background-color: var(--color-surface);
    padding: 1rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .spec-item.highlight {
    background-color: #fcebeb;
    border: 1px solid #f9ccd1;
  }

  .spec-item.highlight .spec-value {
    color: var(--color-text);
  }

  .spec-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    letter-spacing: 0.025em;
  }

  .spec-value {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
  }

  /* Breadcrumbs and Star Rating Styles */
  .recipe-header-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .recipe-header-meta {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .breadcrumb-link {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .breadcrumb-link:hover {
    color: var(--color-primary);
  }

  .breadcrumb-separator {
    color: var(--color-border);
  }

  .rating-block {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .star-icon {
    width: 16px;
    height: 16px;
  }

  .rating-text {
    font-size: 0.825rem;
    color: var(--color-text-muted);
  }

  .rating-text strong {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
