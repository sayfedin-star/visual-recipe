---
import Card from './Card.astro';

interface Props {
  recipes: Array<{
    _id: string;
    title: string;
    slug: string;
    excerpt: string;
    mainImage: any;
    cardAspectRatio?: 'standard' | 'tall' | 'super-tall';
    badges?: string[];
    intentTags?: string[];
    season?: string;
    parentCluster?: { title: string; slug: string };
  }>;
  initialCount?: number;
}

const { recipes = [], initialCount = 12 } = Astro.props;
---

<div class="feed-container">
  {recipes.length === 0 ? (
    <div class="empty-feed">
      <p>No recipes found matching these filters.</p>
    </div>
  ) : (
    <>
      <div class="masonry-grid" id="recipes-feed">
        {recipes.slice(0, initialCount).map((recipe, index) => (
          <div 
            class="masonry-item"
            data-feed-item
            data-intent={recipe.intentTags?.join(' ')}
            data-season={recipe.season}
            data-cluster={recipe.parentCluster?.slug}
            data-badges={recipe.badges?.join(' ')}
          >
            <Card recipe={recipe} loading="lazy" />
          </div>
        ))}
      </div>

      {recipes.length > initialCount && (
        <script
          type="application/json"
          id="feed-remaining-data"
          set:text={JSON.stringify(
            recipes.slice(initialCount).map(r => ({
              _id: r._id,
              title: r.title,
              slug: r.slug,
              excerpt: r.excerpt,
              cardAspectRatio: r.cardAspectRatio || 'tall',
              badges: r.badges || [],
              parentCluster: r.parentCluster || null,
              publicationType: r.publicationType || 'single',
              jumpToRecipeAnchor: r.jumpToRecipeAnchor || 'recipe-card',
              imageUrl: r.mainImage?.asset?._ref
                ? r.mainImage.asset._ref
                    .replace('image-', '')
                    .replace(/-(\w+)$/, '.$1')
                : null
            }))
          )}
        />
      )}

      {recipes.length > initialCount && (
        <div class="feed-actions" id="load-more-container">
          <button id="load-more-btn" class="load-more-button">
            Discover More Recipes
          </button>
        </div>
      )}
    </>
  )}
</div>

<script>
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreContainer = document.getElementById('load-more-container');
  const feed = document.getElementById('recipes-feed');
  const dataEl = document.getElementById('feed-remaining-data');

  if (loadMoreBtn && feed && dataEl) {
    let remainingRecipes: any[] = [];
    try { remainingRecipes = JSON.parse(dataEl.textContent || '[]'); } catch {}

    const step = 8;
    let currentIndex = 0;

    const aspectMap: Record<string, string> = {
      standard: 'aspect-[4/3]',
      tall: 'aspect-[2/3]',
      'super-tall': 'aspect-[1/2]',
    };

    function buildCardHTML(r: any): string {
      const aspect = aspectMap[r.cardAspectRatio] || 'aspect-[2/3]';
      const aspectHeight = r.cardAspectRatio === 'standard' ? 300 : r.cardAspectRatio === 'super-tall' ? 800 : 600;
      const baseImgUrl = r.imageUrl
        ? `https://cdn.sanity.io/images/k8dfrtog/production/${r.imageUrl}`
        : '/favicon.svg';
      const imgSrc = r.imageUrl
        ? `${baseImgUrl}?w=400&q=65&auto=format`
        : '/favicon.svg';
      const imgSrcSet = r.imageUrl
        ? `${baseImgUrl}?w=200&q=65&auto=format 200w, ${baseImgUrl}?w=400&q=65&auto=format 400w, ${baseImgUrl}?w=600&q=65&auto=format 600w`
        : '';
      const sizes = "(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 50vw";
      const clusterBadge = r.parentCluster
        ? `<a href="/hub/${r.parentCluster.slug}" class="category-badge">${r.parentCluster.title}</a>`
        : '';
      const roundupBadge = r.publicationType === 'roundup'
        ? `<span class="roundup-badge">Round-Up</span>`
        : '';
      const badgesHTML = r.badges.slice(0, 2)
        .map((b: string) => `<span class="badge">${b}</span>`)
        .join('');

      return `
        <article class="recipe-card" data-recipe-id="${r._id}">
          <div class="image-container ${aspect}">
            <a href="/recipe/${r.slug}" class="image-link"
               aria-label="View recipe instructions for ${r.title}">
              <img src="${imgSrc}" srcset="${imgSrcSet}" sizes="${sizes}" alt="${r.title}" width="400" height="${aspectHeight}"
                   loading="lazy" decoding="async" class="card-img" />
              <div class="hover-overlay">
                <span class="view-btn">View Recipe</span>
                <span class="save-btn" data-save-btn>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                    <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                  </svg>
                </span>
              </div>
            </a>
            ${clusterBadge}${roundupBadge}
          </div>
          <div class="card-details">
            <a href="/recipe/${r.slug}" class="title-link">
              <h3 class="card-title">${r.title}</h3>
            </a>
            <p class="card-excerpt">${r.excerpt || ''}</p>
            ${badgesHTML ? `<div class="card-badges">${badgesHTML}</div>` : ''}
          </div>
        </article>`;
    }

    loadMoreBtn.addEventListener('click', () => {
      const batch = remainingRecipes.slice(currentIndex, currentIndex + step);
      let savedList: string[] = [];
      try { savedList = JSON.parse(localStorage.getItem('saved-recipes') || '[]'); } catch {}

      batch.forEach(r => {
        const wrapper = document.createElement('div');
        wrapper.className = 'masonry-item';
        wrapper.setAttribute('data-feed-item', '');
        wrapper.innerHTML = buildCardHTML(r);

        // Sync saved state on newly generated card
        if (savedList.includes(r._id)) {
          const saveBtn = wrapper.querySelector('[data-save-btn]');
          if (saveBtn) {
            saveBtn.classList.add('saved');
          }
        }

        wrapper.animate(
          [{ opacity: 0, transform: 'translateY(15px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 350, easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)', fill: 'forwards' }
        );
        feed.appendChild(wrapper);
      });
      currentIndex += step;
      if (currentIndex >= remainingRecipes.length) {
        loadMoreContainer!.style.display = 'none';
      }
    });
  }
</script>

<style>
  .feed-container {
    width: 100%;
    margin-top: 1.5rem;
  }

  .empty-feed {
    text-align: center;
    padding: 4rem 2rem;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  /* CSS Columns Masonry Engine */
  .masonry-grid {
    column-count: 2;
    column-gap: 0.75rem;
    width: 100%;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 0.75rem;
    display: block;
  }

  /* Hidden item styling */
  .hidden-item {
    display: none !important;
  }

  /* Responsive column mappings */
  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
      column-gap: 1.25rem;
    }
    .masonry-item {
      margin-bottom: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  @media (min-width: 1280px) {
    .masonry-grid {
      column-count: 4;
    }
  }

  /* Load More Action Button styling */
  .feed-actions {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
    margin-bottom: 4rem;
  }

  .load-more-button {
    background-color: #111111;
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.9rem 2.2rem;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .load-more-button:hover {
    background-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .load-more-button:active {
    transform: translateY(0);
  }
</style>
